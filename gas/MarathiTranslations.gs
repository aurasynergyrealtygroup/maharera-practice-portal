function applyMarathiTranslations() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName("Questions");
  if (!sh) throw new Error('Run setupSheets() first — "Questions" sheet not found.');

  const values = sh.getDataRange().getValues();
  const headers = values[0];
  const qidCol = headers.indexOf("QID");
  const qMrCol = headers.indexOf("QuestionMr");
  const aMrCol = headers.indexOf("OptionAMr");
  const bMrCol = headers.indexOf("OptionBMr");
  const cMrCol = headers.indexOf("OptionCMr");
  const dMrCol = headers.indexOf("OptionDMr");

  if (qMrCol === -1) {
    throw new Error('Questions sheet is missing Marathi columns. Re-run setupSheets() (it only adds missing headers, safe on existing data) or add QuestionMr/OptionAMr/OptionBMr/OptionCMr/OptionDMr columns by hand after "Marks".');
  }

  let updated = 0;
  for (let r = 1; r < values.length; r++) {
    const qid = values[r][qidCol];
    const t = MARATHI_TRANSLATIONS_BATCH1[qid];
    if (!t) continue;
    sh.getRange(r + 1, qMrCol + 1).setValue(t.questionMr);
    sh.getRange(r + 1, aMrCol + 1).setValue(t.optionAMr);
    sh.getRange(r + 1, bMrCol + 1).setValue(t.optionBMr);
    sh.getRange(r + 1, cMrCol + 1).setValue(t.optionCMr);
    sh.getRange(r + 1, dMrCol + 1).setValue(t.optionDMr);
    updated++;
  }

  SpreadsheetApp.flush();
  Logger.log("Applied Marathi translations to " + updated + " questions (Batch 1: Q0001-Q0050).");
}
